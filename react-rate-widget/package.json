{
  "name": "@rateapi/react-rate-widget",
  "version": "1.0.0",
  "description": "Embeddable React component for displaying live financial rates (mortgages, auto loans, HELOCs, personal loans, credit cards) from RateAPI",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "express": "^4.18.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  },
  "keywords": [
    "react",
    "mortgage",
    "auto-loan",
    "heloc",
    "personal-loan",
    "credit-card",
    "rates",
    "widget",
    "rateapi",
    "credit-union",
    "fintech",
    "embeddable",
    "component"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/holdequity/rateapi-demos.git",
    "directory": "react-rate-widget"
  },
  "license": "MIT",
  "author": "RateAPI <hello@rateapi.dev>"
}
