# OpenAI API Key (required)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# RateAPI Key (required for rate searches)
# Get one at: https://rateapi.dev
RATEAPI_KEY=your-rateapi-key

# Optional: Override the RateAPI URL
# RATEAPI_URL=https://api.rateapi.dev

# Optional: Server port for web interface
# PORT=3000

# Optional: Enable debug logging
# DEBUG=true
